{
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},
	"AllowedHosts": "*",

	//Settings for the refreshing
	"Refresh": {
		//How long to wait between refreshing
		"Seconds": 30,
		//How many things to refresh at once time
		"Parallel": 10
	},
	
	//Put each of your connection strings here, the key is the name of the database shown on the UI
	"ConnectionStrings": {
		"Alpha": "Server=localhost\\sqlexpress;Initial Catalog=aplha;MultipleActiveResultSets=True;",
		"Beta": "Server=localhost\\sqlexpress;Initial Catalog=beta;MultipleActiveResultSets=True;",
		"Charlie": "Server=localhost\\sqlexpress;Initial Catalog=charlie;MultipleActiveResultSets=True;"
	}
}
